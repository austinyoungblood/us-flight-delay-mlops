# Non-secret local defaults and external dependency variable names.
API_URL=http://api:8000
AWS_REGION=us-west-2
DYNAMODB_TABLE=flight-delay-events
MODEL_DOWNLOAD_DIR=/tmp/flight-delay-model
PREDICTION_CACHE_MAXSIZE=1024
PREDICTION_CACHE_TTL_SECONDS=300
WANDB_PROJECT=us-flight-delay-mlops
WANDB_ENTITY=your-wandb-entity
WANDB_MODE=online

# WANDB_API_KEY is required at runtime. The serving alias is deliberately not an
# environment setting: release/release_decision.json is the only control plane.
# Put secrets only in an untracked .env or exported shell variables. AWS Academy
# sessions may also require AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, and
# AWS_SESSION_TOKEN; never commit them.
