# Non-secret local defaults and W&B variable names.
API_URL=http://api:8000
MODEL_ALIAS=production
AWS_REGION=us-west-2
DYNAMODB_TABLE=flight-delay-events
WANDB_PROJECT=us-flight-delay-mlops
WANDB_ENTITY=your-wandb-entity
WANDB_MODE=online

# Add WANDB_API_KEY only to an untracked local .env or export it in your shell.
# Never commit AWS access keys; deployed services will use an instance role.
