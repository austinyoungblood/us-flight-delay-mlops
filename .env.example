# Non-secret local defaults and external dependency variable names.
API_BASE_URL=http://api:8000
API_HOST_PORT=8000
USER_UI_HOST_PORT=8501
MONITOR_UI_HOST_PORT=8502
DYNAMODB_LOCAL_PORT=8001
API_CONNECT_TIMEOUT_SECONDS=5
API_READ_TIMEOUT_SECONDS=15
AWS_REGION=us-west-2
DYNAMODB_TABLE=flight-delay-events
# Development only. Leave unset for AWS; Compose sets http://dynamodb-local:8000.
DYNAMODB_ENDPOINT_URL=
MONITOR_DEFAULT_DAYS=7
MONITOR_MAX_DAYS=31
MONITOR_QUERY_CACHE_TTL_SECONDS=30
MODEL_DOWNLOAD_DIR=/tmp/flight-delay-model
PREDICTION_CACHE_MAXSIZE=1024
PREDICTION_CACHE_TTL_SECONDS=300
WANDB_PROJECT=us-flight-delay-mlops
WANDB_ENTITY=your-wandb-entity
WANDB_MODE=online

# WANDB_API_KEY is required at runtime. The serving alias is deliberately not an
# environment setting: release/release_decision.json is the only control plane.
# Put secrets only in an untracked .env or exported shell variables. Do not add or
# validate AWS Academy credentials during the Brief 07 local-only increment.
