# Non-secret local Docker Compose defaults and external dependency placeholders.
#
# Copy this file to the repository-root .env, populate the two W&B placeholders,
# and keep the populated copy untracked. These values target DynamoDB Local; live
# AWS hosts use the separate component templates in this directory.
API_BASE_URL=http://api:8000
API_HOST_PORT=8000
USER_UI_HOST_PORT=8501
MONITOR_UI_HOST_PORT=8502
DYNAMODB_LOCAL_PORT=8001
API_CONNECT_TIMEOUT_SECONDS=5
API_READ_TIMEOUT_SECONDS=15
# Local Compose region only; this is not evidence of the live deployment region.
AWS_REGION=us-west-2
DYNAMODB_TABLE=flight-delay-events
# Compose supplies the container-local endpoint. Do not put a live AWS endpoint here.
DYNAMODB_ENDPOINT_URL=
MONITOR_DEFAULT_DAYS=7
MONITOR_MAX_DAYS=31
MONITOR_QUERY_CACHE_TTL_SECONDS=30
MODEL_DOWNLOAD_DIR=/tmp/flight-delay-model
PREDICTION_CACHE_MAXSIZE=1024
PREDICTION_CACHE_TTL_SECONDS=300
WANDB_PROJECT=us-flight-delay-mlops
WANDB_ENTITY=your-wandb-entity
WANDB_API_KEY=

# The serving alias is deliberately not an environment setting:
# release/release_decision.json is the only model control plane. Never add AWS
# credentials, account identifiers, endpoint addresses, or session values here.
